# Copy to .env.local and adjust as needed.

# Backend the Vite dev-server proxy forwards /api to (see vite.config.ts).
# Defaults to http://localhost:8001 if unset.
VITE_BACKEND_URL=http://localhost:8001

# Optional: bypass the dev proxy and point the app directly at an API host.
# Leave empty in dev so the proxy handles same-origin /api requests.
# VITE_API_BASE_URL=
