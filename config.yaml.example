# Collaborator Configuration — TEMPLATE
#
# Copy this file to config.yaml (same directory) and edit. config.yaml is
# GITIGNORED: it is your machine's actual config, holding machine-specific
# values and secrets, and no git operation will ever touch or revert it.
# It is the ONLY file a human edits — app-chosen settings (e.g. the model
# dropdown) persist separately to backend/data/app_settings.json.
#
# Precedence: built-in defaults < config.yaml < app_settings.json < env vars.

# Inference settings
inference:
  endpoint_url: "http://<your-tailnet-ip>:1234/v1"  # Replace with your LM Studio's tailnet IP
  model_id: "qwen/qwen3-coder-next"
  # Recommended when the chat model is large: a small model for UTILITY calls
  # (titles, recall/tool synthesis) — faster, and background work stops
  # evicting the chat model's KV cache. Note drafts always use the chat model.
  # utility_model: "qwen/qwen3-4b-2507"
  temperature: 0.7
  max_tokens: 2048
  thinking_mode: false
  streaming: true
  # Chain-of-thought streams to the UI as 'reasoning' events (display-only).
  # Every server dialect is recognized automatically: side fields
  # (reasoning_content / reasoning / thinking) and inline markers (<think>,
  # gpt-oss harmony <|channel|>analysis). Set false to hide it (a keepalive
  # heartbeat covers long thinks instead).
  # stream_reasoning: true
  # gpt-oss reasoning depth ("low" | "medium" | "high"). Leave unset for
  # models/servers that don't accept the field.
  # reasoning_effort: "medium"

# Memory settings
memory:
  default_context_window: 20   # prior turns offered to the model per message
  # Tokens of conversation history per prompt; the oldest turns are dropped
  # past it, and a single oversized turn keeps its end. The model's own
  # context window (detected from LM Studio) always applies as well.
  # Omit or null for no cap beyond the model.
  # context_budget_tokens: 16000
  # Without authentication this single DB is used; with it, each user gets
  # users/<identity-hash>/conversations.db next to it. Relative to the repo root.
  db_path: "backend/data/conversations.db"

# Server settings
server:
  backend_host: "0.0.0.0"
  backend_port: 8001
  cors_origins:
    - "https://collaborator.example.com"  # your public origin
    - "http://localhost:3000"             # Vite dev server; remove for production

# Authentication: ON by default. Create a passkey first
# (cd backend && .venv/bin/python data/passkey.py create) or every request is
# refused. Set enabled: false only for a throwaway local setup (one anonymous
# account, no lock screen).
authentication:
  enabled: true
  passkeys_db_path: "backend/data/authentication/passkeys.db"
  users_dir: "backend/data/users"
  session_idle_days: 30        # a device logs out after this long unused
  session_absolute_days: 90    # ...and after this long regardless
  lockout_threshold: 5         # failed passkey attempts before backoff kicks in
  lockout_base_seconds: 60
  lockout_max_seconds: 3600

# System prompt configuration
system_prompt:
  text: "You are Collaborator, a helpful assistant."   # used only when file_path is null
  file_path: "system-prompt.md"   # the editable prompt in the repo root
  # Auditable prompt layers appended to the base prompt, each its own markdown file
  # (read fresh each turn, so edits apply without a restart). Defaults shown.
  paragraph_file: "paragraph-style.md"   # always appended: one-idea-per-block for branching
  voice_file: "voice-style.md"           # appended only on voice (call-mode) turns
  # Inline string fallbacks if you prefer not to use files (file takes precedence):
  # paragraph_text: "Put each distinct idea in its own blank-line-separated block."
  # voice_text: "Speak in plain conversational prose with no markdown or symbols."
  # Date/time grounding: appended every turn with {now} filled in (server local
  # time), so the model doesn't insist on training-cutoff facts. Override if desired:
  # datetime_text: "Current date and time: {now}. Trust this over your memory."
  # datetime_file: "datetime-line.md"   # or keep it in a file like the other layers

# Speech-to-text (faster-whisper / CTranslate2). Defaults: CPU, int8, 'base' model.
# For a GPU box use device: cuda and compute_type: float16.
# NOTE: superseded by voice.stt below for model names; still honored for
# device/compute fallbacks on older configs.
# transcription:
#   model: "base"          # tiny | base | small | medium | large-v3 (or *.en variants)
#   device: "cpu"          # cpu | cuda
#   compute_type: "int8"   # int8 (cpu) | float16 (gpu) | int8_float16

# Server voice tier (streaming STT sessions, in-stream phrase detection, TTS).
# Advertised via GET /api/health "capabilities"; the frontend uses its on-device
# stack per engine when a capability is absent. See voice.py.
#
# RECOMMENDED deployment: run the models on the inference machine via speaches
# (https://speaches.ai — OpenAI-compatible /v1/audio server; LM Studio has no
# audio endpoints) and point backend: openai at it:
# voice:
#   stt:
#     backend: "openai"
#     api_url: "http://<inference-host>:8000/v1"      # speaches on the inference box
#     partial_model: "Systran/faster-whisper-small.en"
#     final_model: "deepdml/faster-whisper-large-v3-turbo-ct2"
#     final_pass: true                # false = live partials become the message
#                                     # (fastest end-of-turn; final_model still
#                                     # used for uploads + video transcription)
#     preload: true                   # probes the server at startup
#   phrases:
#     silence_ms: 350                 # trailing quiet that confirms a matched phrase
#   tts:
#     backend: "openai"
#     api_url: "http://<inference-host>:8000/v1"
#     model: "speaches-ai/Kokoro-82M-v1.0-ONNX"
#     default_voice: "af_heart"
#     # Voices are discovered from the sidecar automatically (all the model's
#     # voices are offered). Uncomment to curate the picker to a subset:
#     # remote_voices: ["af_heart", "am_adam", "bf_emma"]
#     remote_sample_rate: 24000
#     preload: true                   # warm the models at startup (no cold first call)       # Kokoro emits 24 kHz PCM (Piper voices: 22050)
#
# ALTERNATIVE (self-contained): run the models inside this backend process:
# voice:
#   stt:
#     partial_model: "small"          # rolling partials (speed matters)
#     final_model: "large-v3-turbo"   # final pass (accuracy matters)
#     preload: true                   # warm-load at startup on the voice host
#   tts:
#     voices_dir: "backend/data/tts-voices"   # <voice>.onnx + .onnx.json files
#     default_voice: "en_US-lessac-medium"
#     preload: true

# Recall (memory). Embeddings run LOCALLY on the backend by default (fastembed,
# ONNX, no PyTorch). Synthesis always uses the LM Studio chat model. Disabled by
# default; the frontend can also toggle it per request.
recall:
  enabled: false
  embedding_backend: "local"                  # "local" (fastembed) or "lmstudio"
  embedding_model_local: "BAAI/bge-small-en-v1.5"  # local model (downloads once, ~130MB)
  # embedding_model: "text-embedding-nomic-embed-text-v1.5"  # only if backend: lmstudio
  search_limit: 10            # max similar turns to feed synthesis
  synthesis_max_tokens: 256   # output budget to keep the recall block snappy
  synthesis_prompt_file: "recall-synthesis-prompt.md"  # editable/auditable prompt (like system-prompt.md)
  tag_boosts:                 # multiplicative score boosts per tag
    decision: 1.5
    open_question: 1.2
    concept: 1.3
    reference: 1.4
    emotion: 1.1

# Atomic notes (NOTES-FORMAT.md). Vaults hold APPROVED notes only — drafts live in
# the DB until approved — and are ALWAYS per-user (notes never cross passkeys).
# vault_dir relocates where vaults live; it never merges them: under auth each
# user's vault is <vault_dir>/<user-hash>; without auth it's the vault itself.
# Machine-specific, so set it in .config.yaml (e.g. "/srv/vaults" and serve
# /srv/vaults/<your-hash> from Obsidian). Unset -> vaults sit next to each user's
# conversation DB (users/{hash}/notes, else backend/data/notes).
notes:
  # vault_dir: "/srv/vaults"
  # Tree -> note-drafts synthesis (POST /api/notes/synthesize/{tree_id})
  synthesis_prompt_file: "synthesis-notes.md"  # editable/auditable prompt
  synthesis_max_tokens: 4096   # output budget for the whole batch of drafts
  synthesis_temperature: 0.3
  synthesis_timeout: 300       # seconds; big trees take a while on local inference
  # Dedupe-against-vault: existing notes are shown to the synthesis LLM (link, don't
  # duplicate), and candidates near an existing note get duplicate_of on the draft.
  dedupe_threshold: 0.85       # cosine similarity above which a candidate is flagged
  dedupe_context_notes: 30     # how many existing notes to show the model

# Auto-generated conversation titles, stored on root turns (seeds and trees alike;
# separate from the user-set name — the UI renders name ?? title ?? preview).
# Generated after an exchange completes (never delays the reply) and lazily
# regenerated once the tree grows by regenerate_after_turns. Editable prompt in
# title-prompt.md. Force-refresh via POST /api/turns/{id}/title.
titles:
  enabled: true
  regenerate_after_turns: 6
  temperature: 0.3
  max_tokens: 24
  timeout: 30
  prompt_file: "title-prompt.md"

# Notifications. Which kinds notify is chosen in the app (Settings →
# Notifications); this block is only delivery. Every notification is stored in
# the app either way; nothing leaves this box until ntfy is configured.
notifications:
  app_url: null               # public URL of this app, so tapping a notification opens it
  ntfy:                       # a self-hosted ntfy server (https://ntfy.sh/docs/install/)
    url: null                 # e.g. "https://<ntfy-host>"
    token: null               # access token, if your server requires auth
    topics: {}                # per user, keyed like tools.nwc.connections
    # topics:
    #   default: "<random-topic-name>"          # authentication disabled
    #   "<user-identity-hash>": "<random-topic>" # one per user under auth
    timeout: 10

# The chat card's summary (three dots on a chat): generated on demand by
# inference.utility_model, cached on the chat, marked stale once it grows.
# Generating it also proposes tags, which are only applied when accepted.
chat_summary:
  temperature: 0.3
  max_tokens: 768             # reasoning models spend this on thinking first
  timeout: 60
  prompt_file: "chat-summary-prompt.md"

# Tool-calling. When enabled, the model drives retrieval/synthesis by calling tools
# (recall is a set of tools) and streams status notes for what it's doing. Requires a
# tool-capable chat model in LM Studio (qwen3-coder-next works). Off by default.
tools:
  enabled: false
  status_notes: true          # stream a short "what it's doing" note per tool step
  show_step_results: false    # also stream each tool's raw results
  max_rounds: 12              # max tool rounds before forcing an answer (binds crawl depth too)
  temperature: 0.3            # tool-loop temperature (lower = more reliable tool calls)
  guidance_file: "tools-guidance.md"  # editable "when to use tools" instruction (system prompt)
  spec_file: "tools-spec.md"          # editable per-tool descriptions the model sees (the tool schemas)
  auto_recall_fallback: false # reserved for later
  available:                  # enable/disable individual tools
    recall_semantic: true     # semantic (embedding) search over turns
    recall_keyword: true      # lexical keyword search over turns
    synthesize: true          # synthesize retrieved items into a block
    search_notes: true        # search the notes vault (curated knowledge)
    get_note: true            # read one note in full (body + backlinks)
    propose_note: true        # propose a note -> PENDING draft only (user approves)
    propose_edit: true        # propose edits to an existing note -> PENDING draft too
    web_search: true          # self-gating: active only when web_search.url is set
    fetch_url: true           # read a specific page (pasted links)
    screenshot_page: true     # self-gating: needs webtool_url + screenshot.vision_model
    transcribe_video: true    # yt-dlp audio -> STT for a new URL (never captions)
    list_transcripts: true    # catalogue of stored transcripts (cheap, browsable)
    read_transcript: true     # read one stored transcript by id, paged
    read_logs: true           # agent can read its own recent server logs (ring buffer)
    nwc_pay: true             # self-gating: active only when tools.nwc.connections has
                              # an entry for the requesting user
    lethe_search: true        # self-gating: active only when tools.lethe.url is set
  transcribe_video:
    sync_max_minutes: 10      # videos up to this long transcribe within the turn
    max_minutes: 240          # hard cap; longer videos are refused
    return_chars: 15000       # transcript characters per part handed to the model
    # proxy: "socks5://<proxy-host>:1080"   # optional yt-dlp egress proxy
  web_search:
    # Provider switch — the tool registers only when the SELECTED provider's
    # credential is set:
    #   searxng: private instance, queries egress via the search VM; needs url
    #            (JSON format enabled in its settings.yml:
    #            search.formats: [html, json])
    #   brave:   Brave Search API, direct HTTPS from this box (NOT private —
    #            queries are tied to your API key); needs brave_api_key
    provider: "brave"
    brave_api_key: "YOUR-BRAVE-API-KEY"
    # country: "us"           # brave only: result country (optional)
    url: "http://<search-vm-ip>"  # searxng base URL (kept for switching back)
    results: 5                # max results returned to the model
    timeout: 15
    language: "en"
    safesearch: 0             # 0/1/2 (brave maps to off/moderate/strict)
  fetch_url:
    max_chars: 8000           # readable text handed to the model per page
    timeout: 20
    allow_private: false      # true to allow tailnet/LAN URLs (off = public web only)
    max_links: 40             # hyperlinks returned per page (lets the model follow links)
    max_per_turn: 10          # hard fetch budget per message (bounds link-following)
    same_domain_only: false   # true: follow-up fetches must stay on the first page's host
    # PREFERRED: route page fetches through the search VM's Playwright service
    # ("webtool") — headless Chromium that egresses via the VM's VPN, so fetched
    # pages never see this machine's IP, and JS-heavy pages actually render.
    # Fails CLOSED when the service is unreachable (never silently falls back to
    # a direct clearnet fetch).
    webtool_url: "http://<search-vm-ip>:8200"
    webtool_timeout: 60       # >= 45s recommended (30s nav timeout + render + transfer)
    webtool_wait_ms: 0        # extra JS settle ms; near-empty pages auto-retry at 2500
    # Without webtool_url, fetches go DIRECT from this machine (pages see this
    # box's IP). A proxy can route that direct path instead:
    # proxy: "socks5h://<tor-or-vpn-host>:9050"   # needs: pip install requests[socks]
  screenshot:                 # visual page analysis: webtool /screenshot -> vision model
    vision_model: "qwen/qwen2.5-vl-7b"  # LM Studio loads it on demand (first call is
                              # slow). Verified working; note llava-v1.6-34b currently
                              # fails in LM Studio's MLX image preprocessing.
    temperature: 0.2
    max_tokens: 512
    timeout: 180              # headroom for the on-demand model load
    text_chars: 2000          # page-text excerpt returned alongside the analysis
  synthesis:
    max_tokens: 256
    prompts:                  # per-kind synthesis prompt files (editable/auditable)
      memory: "recall-synthesis-prompt.md"
      web: "synthesis-web.md"
  nwc:                        # Lightning spending via Nostr Wallet Connect (nwc_pay tool)
    # Connections are PER USER and NEVER live in this repo — wire real values
    # into the gitignored config.yaml on the prod box. Key each entry by the
    # user's identity hash (the directory name under backend/data/users/);
    # with authentication disabled there is one anonymous user, key "default".
    # The string comes from the wallet's NWC pairing (e.g. Zeus: create a
    # connection with its own budget — that budget is the outer spending wall).
    connections: {}
    # connections:
    #   default: "nostr+walletconnect://<wallet-pubkey>?relay=wss://relay.example.com&secret=<64-hex>"
    #   "<user-identity-hash>": "nostr+walletconnect://..."
    max_sats_per_payment: 100 # app-side cap per invoice, on top of the NWC budget
    max_sats_per_day: 500     # app-side rolling daily cap (spend ledger in the per-user DB)
    timeout: 30               # seconds to wait for the wallet's NIP-47 response
    encryption: "auto"        # auto (read the wallet's info event: nip44_v2 when
                              # advertised, else nip04) | nip44 | nip04 to pin one
  lethe:                      # EXPERIMENTAL paid search (lethe_search tool): a Lethe
    url: ""                   # vertical index behind an Aperture L402 proxy, e.g.
                              # "https://lethe.example.com". Empty = tool disabled.
                              # 402 challenges are settled via nwc_pay; the minted
                              # L402 token is stored per user and reused.
    vertical: "cybersec"      # default vertical path segment (/v1/<vertical>/search)
    results: 8                # max results returned to the model
    timeout: 20
