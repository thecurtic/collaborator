# systemd unit for the Collaborator backend (FastAPI/uvicorn).
#
# Install on the server (adjust User and paths to your checkout):
#   sudo cp deploy/collaborator-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now collaborator-backend
#
# Afterwards:
#   sudo systemctl restart collaborator-backend     # or: ./deploy.sh
#   journalctl -u collaborator-backend -f           # logs

[Unit]
Description=Collaborator backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=collaborator
WorkingDirectory=/srv/collaborator/backend
# Port and host are also read from config.yaml; override here if needed.
ExecStart=/srv/collaborator/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
