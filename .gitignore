# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local
# The ACTUAL config is machine-local and never committed (copy from
# config.yaml.example). .config.yaml is deprecated but still ignored.
config.yaml
.config.yaml

# OS files
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/
out/

# Coverage
coverage/
.nyc_output/

# Python caches and virtualenvs. Python's packaging template (lib/, parts/,
# var/, eggs/ ...) is left out: those rules aren't anchored, so they matched
# directories like frontend/src/lib. package-lock.json is tracked (deploy.sh
# runs npm ci).
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
*.egg-info/

# SQLite, with its journal and write-ahead-log sidecars
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Runtime data. Everything under backend/data is per-machine and personal
# (databases, notes vaults, attachments, scratch media, app settings, TTS
# voices, the NWC scheme cache), except the scripts that manage it.
/backend/data/*
!/backend/data/*.py
!/backend/data/users/
/backend/data/users/*
!/backend/data/users/.gitkeep

# Left behind by running the backend before paths resolved from the repo root
/data/

# Worktrees (keep hidden)
.worktrees/
.fake-endpoint-*.key
