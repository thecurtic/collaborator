# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (optional - comment out if you want to track them)
# node_modules/
# dist/

# Environment variables
.env
.env.local
.env.*.local
.config.yaml  # Local overrides (ignored, gitignored)
# Note: config.yaml is now tracked in version control

# OS files
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/
out/

# Coverage
coverage/
.nyc_output/

# Lock files
pnpm-lock.yaml
package-lock.json
yarn.lock

# Python/Backend (only ignore cache files, not the directory itself)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# SQLite
*.db
*.sqlite
*.sqlite3

# User databases (per-machine)
backend/data/users/*/conversations.db
!backend/data/users/.gitkeep

# Authentication database (per-machine)
backend/data/authentication/passkeys.db

# Worktrees (keep hidden)
.worktrees/
