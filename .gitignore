# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (optional - comment out if you want to track them)
# node_modules/
# dist/

# Environment variables
.env
.env.local
.env.*.local
# The ACTUAL config is machine-local and never committed (copy from
# config.yaml.example). App-written settings (model dropdown etc.) live in
# backend/data/app_settings.json. .config.yaml is deprecated but still ignored.
config.yaml
.config.yaml
backend/data/app_settings.json

# OS files
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/
out/

# Coverage
coverage/
.nyc_output/

# Lock files
pnpm-lock.yaml
package-lock.json
yarn.lock

# Python/Backend (only ignore cache files, not the directory itself)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# SQLite
*.db
*.sqlite
*.sqlite3

# User databases (per-machine)
backend/data/users/*/conversations.db
!backend/data/users/.gitkeep

# Authentication database (per-machine)
backend/data/authentication/passkeys.db

# Notes vaults (personal content, never committed)
backend/data/notes/
backend/data/users/*/notes/

# Worktrees (keep hidden)
.worktrees/

# TTS voice models (downloaded per-machine)
backend/data/tts-voices/
