<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd user agent for the gate. install.sh fills in __GATE_DIR__ and
     __LOG__ and copies this to ~/Library/LaunchAgents/. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.inference-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "__GATE_DIR__/.env"; set +a; exec "__GATE_DIR__/.venv/bin/python" "__GATE_DIR__/gate.py"</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__GATE_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
