# inference-gate configuration. Copy to .env (install.sh does, and fills in
# a random GATE_TOKEN if it's empty). The real .env is never committed.

# Where the gate listens. It must be reachable over the tailnet: the agents'
# VMs and Collaborator's host are not on this Mac.
GATE_HOST=0.0.0.0
GATE_PORT=8080

# LM Studio's OpenAI-compatible server, on this Mac.
UPSTREAM_URL=http://127.0.0.1:1234

# Required. Collaborator sends it as "Authorization: Bearer <token>" on
# /gate/* calls; put the same value in Collaborator's config.yaml
# (inference.gate.token). The gate refuses to start without one.
GATE_TOKEN=

# Optional cap on requests in flight to LM Studio at once (unset = no cap).
MAX_CONCURRENT_UPSTREAM=

LOG_LEVEL=INFO
